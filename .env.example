# ============================================================
#  .env.example  →  이 파일을 복사해서 .env.local 로 만들고 값을 채우세요
#  cp .env.example .env.local      (Windows PowerShell: copy .env.example .env.local)
# ============================================================

# ---------- 앱 기본 ----------
# 배포 시 실제 도메인으로 변경 (LinkedIn Redirect URL 과 반드시 일치해야 함)
APP_BASE_URL=http://localhost:3000

# ---------- MongoDB ----------
# MongoDB Atlas > Connect > Drivers 에서 복사한 문자열
# 예: mongodb+srv://admin:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=dataize_admin

# ---------- LinkedIn OAuth ----------
# https://www.linkedin.com/developers/apps > Auth 탭
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn Auth 탭의 "Authorized redirect URLs" 에 아래 값을 그대로 등록해야 합니다
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
# Posts API 버전 (YYYYMM). LinkedIn 은 매월 새 버전을 내며 약 1년간 유효합니다.
LINKEDIN_API_VERSION=202609

# ---------- 보안 키 ----------
# 아래 명령으로 각각 생성해서 붙여넣으세요 (서로 다른 값 사용)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 세션 쿠키 서명용 (32바이트 hex = 64자)
SESSION_SECRET=
# LinkedIn 액세스 토큰 DB 저장 시 AES-256-GCM 암호화용 (32바이트 hex = 64자)
TOKEN_ENCRYPTION_KEY=

# ---------- 지표 수집 방식 ----------
# linkedin : 실제 LinkedIn Analytics API 호출 (r_member_postAnalytics 권한 승인 필요)
# sample   : 권한 미승인 상태에서 화면 검증용 대체 데이터 (UI에 '샘플' 배지가 표시됨)
METRICS_PROVIDER=sample
